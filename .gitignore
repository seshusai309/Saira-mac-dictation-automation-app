# macOS build
.build/
*.xcuserdatad
.DS_Store

# Built .app bundles, at the repo root only. `make` stages the real bundle in
# ~/Library/Caches/SAIsWhisperBuild, never here.
/*.app/

# Local ASR model weights. Large, redistributed under their own license, and FluidAudio
# fetches them itself into ~/Library/Application Support/FluidAudio.
models/
*.onnx
*.nemo
